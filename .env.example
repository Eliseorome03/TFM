# ==============================================================================
# .env.example — Variables de entorno del Sistema Neurosimbólico Bancario
#
# INSTRUCCIONES:
#   1. Copiar este archivo como `.env` en la raíz del proyecto:
#        cp .env.example .env
#   2. Rellenar MISTRAL_API_KEY con tu clave real de https://console.mistral.ai/
#   3. El resto de valores están preconfigurados para el entorno Docker local.
#   4. NO commitar el archivo `.env` con claves reales al repositorio Git.
#
# ARQUITECTURA:
#   - mariadb   → Puerto 3306 (interno) / 3306 (host)
#   - drools-app → Puerto 8080 (interno) / 8080 (host)
#   - backend   → Puerto 8000 (interno) / 8000 (host)
#   - Frontend  → http://localhost:8000/static/index.html
# ==============================================================================


# ── MISTRAL AI ──────────────────────────────────────────────────────────────────
# Clave de API para el servicio Mistral (NLU extracción de entidades + NLG respuesta)
# Obtener en: https://console.mistral.ai/api-keys
# REQUERIDO: El sistema no funcionará sin esta clave.
MISTRAL_API_KEY=your_mistral_api_key_here

# Modelo de Mistral a utilizar (recomendado: mistral-large-latest para JSON estructurado)
MISTRAL_MODEL=mistral-large-latest


# ── BASE DE DATOS MariaDB ───────────────────────────────────────────────────────
# Credenciales para el contenedor mariadb (deben coincidir entre los 3 servicios)

# Contraseña del superusuario root (solo para operaciones administrativas)
MARIADB_ROOT_PASSWORD=root_secret_2024

# Base de datos principal (creada automáticamente por init.sql)
MARIADB_DATABASE=banca_db

# Usuario de aplicación (usado por el backend FastAPI para conexiones ORM)
MARIADB_USER=banca_user
MARIADB_PASSWORD=banca_password_2024

# Puerto expuesto al host (3306 es el estándar MariaDB)
MARIADB_PORT=3306


# ── MOTOR DE REGLAS DROOLS ──────────────────────────────────────────────────────
# Puerto expuesto del contenedor drools-app al host
DROOLS_PORT=8080

# Timeout en segundos para llamadas HTTP del backend a Drools
DROOLS_TIMEOUT=30


# ── BACKEND FastAPI ─────────────────────────────────────────────────────────────
# Puerto expuesto del contenedor backend al host
BACKEND_PORT=8000

# NOTA: DATABASE_URL y DROOLS_URL se construyen dinámicamente en docker-compose.yml
# usando las variables MARIADB_* y el nombre DNS interno del servicio drools-app.
# No es necesario definirlas aquí salvo para override manual:
#
# DATABASE_URL=mysql+pymysql://banca_user:banca_password_2024@mariadb:3306/banca_db
# DROOLS_URL=http://drools-app:8080/api/evaluate
