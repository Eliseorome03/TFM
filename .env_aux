# ==============================================================================
# .env — Variables de entorno del Sistema Neurosimbólico Bancario
# Este archivo es leído por docker-compose.yml para configurar todos los servicios.
# ==============================================================================

# ── MISTRAL AI ──────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# ── BASE DE DATOS MariaDB ───────────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=root_secret_2024
MARIADB_DATABASE=banca_db
MARIADB_USER=banca_user
MARIADB_PASSWORD=banca_password_2024
MARIADB_PORT=3306

# ── MOTOR DE REGLAS DROOLS ──────────────────────────────────────────────────────
DROOLS_PORT=8080
DROOLS_TIMEOUT=30

# ── BACKEND FastAPI ─────────────────────────────────────────────────────────────
BACKEND_PORT=8000