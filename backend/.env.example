# ============================================================
# .env.example — Variables de entorno requeridas por el backend
# Copiar este archivo como .env y rellenar los valores reales
# ============================================================

# --- Base de Datos MariaDB ---
# Formato: mysql+pymysql://<usuario>:<password>@<host>:<puerto>/<nombre_base_datos>
DATABASE_URL=mysql+pymysql://tfm_user:tfm_password@mariadb:3306/tfm_neurosimbolico

# --- API Key de Mistral ---
# Obtener en: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# --- URL del microservicio Drools ---
# Apunta al contenedor drools-app corriendo en el puerto 8080
DROOLS_URL=http://drools-engine:8080/api/evaluate

# --- Modelo de Mistral a utilizar ---
# Recomendado: mistral-large-latest (structured output garantizado)
MISTRAL_MODEL=mistral-large-latest

# --- Timeout para llamadas HTTP a Drools (segundos) ---
DROOLS_TIMEOUT=30

# --- Ruta al archivo de datos mock del BdE (CIRBE/ASNEF) ---
BDE_JSON_PATH=bde.json
